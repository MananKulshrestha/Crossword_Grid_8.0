FKGRID_MODEL_MODE=live
FKGRID_MODEL_ALIAS=google/gemma-4-26b-a4b-it
FKGRID_MODEL_PROTOCOL=deepinfra
FKGRID_MODEL_ENDPOINT=https://api.deepinfra.com/v1/openai/chat/completions
DEEPINFRA_API_KEY=
FKGRID_MODEL_API_KEY=
# Optional: model alias for the translation agent (translate.py). Defaults to
# FKGRID_MODEL_ALIAS above if unset - point this at a DeepInfra Gemini or
# Gemma-4 alias, e.g. "google/gemini-2.0-flash-001".
FKGRID_TRANSLATE_MODEL_ALIAS=
FKGRID_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FKGRID_TEST_CATALOG_SIZE=600
FKGRID_TEST_CATALOG_SEED=20260801
FKGRID_SPEECH_MODE=live
FKGRID_SPEECH_MODEL_ALIAS=openai/whisper-large-v3-turbo
FKGRID_SPEECH_ENDPOINT=https://api.deepinfra.com/v1/inference/openai/whisper-large-v3-turbo
FKGRID_SPEECH_DEADLINE_MS=8000
FKGRID_SPEECH_LANGUAGE=en
FKGRID_SPEECH_MAX_AUDIO_BYTES=20971520
# "fixture" (default): in-memory demo cart, no setup needed.
# "database": DatabaseCartAdapter (Track 6), real MySQL-backed cart -- needs
# flipkart-mysql running (see RA/db/schema_tier1.sql, schema_cart.sql). See
# runtime.py's ApiRuntime.__init__ docstring/comment for the known catalog-
# version mismatch this mode currently has with search.
FKGRID_CART_MODE=fixture
FLIPKART_DB_HOST=127.0.0.1
FLIPKART_DB_PORT=3307
FLIPKART_DB_USER=flipkart_user
FLIPKART_DB_PASSWORD=flipkart_pass
FLIPKART_DB_NAME=flipkart
FLIPKART_DB_CONNECT_TIMEOUT_SECONDS=5
FLIPKART_DB_READ_TIMEOUT_SECONDS=5
FLIPKART_DB_WRITE_TIMEOUT_SECONDS=5
