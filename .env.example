# Runtime-only provider configuration. Never commit a real key.
FKGRID_GEMMA_PROVIDER=deepinfra
FKGRID_USE_GEMMA=false
FKGRID_DEEPINFRA_API_KEY=
FKGRID_GEMMA_MODEL_ALIAS=google/gemma-4-26B-A4B-it
FKGRID_DEEPINFRA_ENDPOINT=https://api.deepinfra.com/v1/openai/chat/completions
FKGRID_GEMMA_TIMEOUT_MS=1800

# Optional legacy compatibility provider. Use only with FKGRID_GEMMA_PROVIDER=gemini.
# FKGRID_GEMMA_API_KEY=
# FKGRID_GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent
