# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real API keys.

# --- Query-time inference backend ----------------------------------------
# Which backend answers QUERY-TIME LLM calls (query.py / web_ui.py). Has NO
# effect on ingest.py -- ingestion always uses the Ollama cluster below,
# regardless of this setting. One of: "deepinfra" (default) or "ollama".
INFERENCE_BACKEND=deepinfra

# --- DeepInfra (query inference only, never used for ingestion) ---------
# https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
# Exact model IDs from DeepInfra's model catalog, e.g.:
#   DEEPINFRA_LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
#   DEEPINFRA_EMBED_MODEL=BAAI/bge-m3
DEEPINFRA_LLM_MODEL=
DEEPINFRA_EMBED_MODEL=

# Which embedding backend query.py uses -- leave unset to default to
# EMBED_BACKEND below (recommended: query embeddings must match whatever
# ingestion used, or vector similarity search silently returns garbage).
# Only set to "deepinfra" here if you've re-embedded the whole corpus with
# DEEPINFRA_EMBED_MODEL too.
# LIGHTRAG_QUERY_EMBED_BACKEND=ollama

# --- Ollama (always used for ingestion; used for query only when
# INFERENCE_BACKEND=ollama or LIGHTRAG_QUERY_EMBED_BACKEND=ollama) --------
OLLAMA_HOST=http://localhost:11345
LIGHTRAG_LLM_MODEL=gemma4:e4b
LIGHTRAG_EMBED_MODEL=nomic-embed-text
LIGHTRAG_EMBED_BACKEND=local

# --- Concurrency / context ------------------------------------------------
LIGHTRAG_NUM_CTX=8192
LIGHTRAG_LLM_MAX_ASYNC=16
LIGHTRAG_EMBEDDING_MAX_ASYNC=4

# --- Qdrant ---------------------------------------------------------------
QDRANT_URL=http://localhost:6333

# --- Ingestion batch size (leave blank for full catalog) ------------------
LIGHTRAG_BATCH_SIZE=
